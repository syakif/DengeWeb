@model DengeWeb.Models.AboutViewModel
@{ ViewData["Title"] = "Hakkımızda"; }

<div class="container my-5">
    
    <!-- Giriş Kısmı -->
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h2 class="fw-bold" style="color: #001f54;">@Model.HeaderTitle</h2>
            <hr class="w-25 mx-auto" style="border-top: 3px solid #0d6efd;">
            <p class="lead mt-4 text-muted">@Model.HeaderSubtitle</p>
        </div>
    </div>

    <!-- Misyon ve Vizyon Bölümü -->
    <div class="row align-items-center mb-5 mt-4">
        <div class="col-md-7 pe-md-5">
            <h3 class="fw-bold mb-3" style="color: #001f54;">@Model.MissionTitle</h3>
            <p>@Model.MissionText</p>
        </div>
        <div class="col-md-5 mt-4 mt-md-0">
            <!-- Görsel 1 Placeholder -->
            <img src="@Model.MissionImage" class="img-fluid rounded shadow navy-frame" alt="Misyon ve Vizyon">
        </div>
    </div>

    <!-- Etik Yaklaşımımız Bölümü -->
    <div class="row mb-5 bg-light py-5 px-3 rounded">
        <div class="col-12">
            <h3 class="fw-bold mb-4" style="color: #001f54;">@Model.EthicsTitle</h3>
            <p>@Model.EthicsText</p>
        </div>
    </div>

    <!-- Değerlerimiz Bölümü -->
    <div class="row align-items-center">
        <!-- Bootstrap 'order' class'ları mobilde resmi üste, yazıyı alta alır. Masaüstünde resim solda kalır. -->
        <div class="col-md-5 order-2 order-md-1 mt-4 mt-md-0">
             <!-- Görsel 2 Placeholder -->
             <img src="/images/denge-elektronik-vizyonumuz.jpg.webp" class="img-fluid rounded shadow navy-frame" alt="Değerlerimiz">
        </div>
        <div class="col-md-7 order-1 order-md-2 ps-md-5">
            <h3 class="fw-bold mb-4" style="color: #001f54;">Değerlerimiz</h3>
            <ul class="list-group list-group-flush">
                <li class="list-group-item bg-transparent border-0 pb-3">
                    <i class="fas fa-check-circle text-primary me-2"></i> Müşterilerimizin memnuniyeti varlık sebebimizdir.
                </li>
                <li class="list-group-item bg-transparent border-0 pb-3">
                    <i class="fas fa-check-circle text-primary me-2"></i> Kendi alanımızda daima zirvede yer almak temel gayemizdir.
                </li>
                <li class="list-group-item bg-transparent border-0 pb-3">
                    <i class="fas fa-check-circle text-primary me-2"></i> Sahip olduğumuz en kıymetli değer, nitelikli insan kaynağımızdır.
                </li>
                <li class="list-group-item bg-transparent border-0 pb-3">
                    <i class="fas fa-check-circle text-primary me-2"></i> Sürdürülebilir büyüme için sürekli yeni kaynaklar üretmeyi hedefleriz.
                </li>
                <li class="list-group-item bg-transparent border-0 pb-3">
                    <i class="fas fa-check-circle text-primary me-2"></i> Dürüstlük ve yüksek iş ahlakı, tüm faaliyetlerimizin değişmez pusulasıdır.
                </li>
                <li class="list-group-item bg-transparent border-0 pb-3">
                    <i class="fas fa-check-circle text-primary me-2"></i> İçinde bulunduğumuz ekonomiye değer katmak ve ondan güç almak başlıca hedefimizdir.
                </li>
            </ul>
        </div>
    </div>

</div>