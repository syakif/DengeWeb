@model DengeWeb.Models.SiteSetting
@{ ViewData["Title"] = "Hakkımızda"; }

<div class="container my-5">
    
    <!-- Giriş Kısmı -->
    <!-- YENİ KURUMSAL İMZA TASARIMI (Sola dayalı, lacivert kalın çizgili) -->
<div class="row mb-5" data-aos="fade-right" data-aos-duration="800">
    <div class="col-12">
        <!-- Modelden gelen başlığı display-5 ve lacivert ile büyüttük -->
        <h1 class="fw-bold display-5" style="color: #001f54; letter-spacing: 1px;">@Model.AboutTitle</h1>
        
        <!-- Mavi <hr> yerine, kurumsal kalın kısa lacivert çizgimizi koyduk -->
        <div style="height: 4px; width: 60px; background-color: #001f54; margin-top: 15px;"></div>
        
        <!-- Modelden gelen alt başlığı da hemen altına, çok daha şık bir fontla yerleştirdik -->
        @if(!string.IsNullOrEmpty(Model.AboutDescription))
        {
            <p class="lead mt-4 text-muted w-75" style="line-height: 1.8;">@Model.AboutDescription</p>
        }
    </div>
</div>

    <!-- Misyon ve Vizyon Bölümü -->
    <div class="row align-items-center mb-5 mt-4" data-aos="fade-up" data-aos-duration="1000">
        <div class="col-md-7 pe-md-5">
            <h3 class="fw-bold mb-3" style="color: #001f54;">@Model.AboutMissionVisionTitle</h3>
            <p>@Model.AboutMissionVisionDescription</p>
        </div>
        <div class="col-md-5 mt-4 mt-md-0">
            <!-- Görsel 1 Placeholder -->
            <img src="@Model.AboutMissionVisionImageUrl" class="img-fluid rounded shadow navy-frame" alt="Misyon ve Vizyon">
        </div>
    </div>
    <!-- Etik Yaklaşımımız Bölümü -->
    <div class="row mb-5 bg-light py-5 px-3 rounded" data-aos="fade-up" data-aos-duration="1000">
        <div class="col-12">
            <h3 class="fw-bold mb-4" style="color: #001f54;">@Model.AboutEthicalValuesTitle</h3>
            <p>@Model.AboutEthicalValuesDescription</p>
        </div>
    </div>

    <!-- Değerlerimiz Bölümü -->
    <div class="row align-items-center" data-aos="fade-up" data-aos-duration="1000">
        <!-- Bootstrap 'order' class'ları mobilde resmi üste, yazıyı alta alır. Masaüstünde resim solda kalır. -->
        <div class="col-md-5 order-2 order-md-1 mt-4 mt-md-0">
             <!-- Görsel 2 Placeholder -->
             <img src="@Model.AboutValuesImageUrl" class="img-fluid rounded shadow navy-frame" alt="Değerlerimiz">
        </div>
        <div class="col-md-7 order-1 order-md-2 ps-md-5">
            <h3 class="fw-bold mb-4" style="color: #001f54;">@Model.AboutValuesTitle</h3>
            <p>@Model.AboutValuesDescription</p>
        </div>
    </div>

</div>