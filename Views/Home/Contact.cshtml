@using Microsoft.Extensions.Caching.Memory
@using DengeWeb.Data
@using DengeWeb.Models
@inject IMemoryCache _cache
@inject ApplicationDbContext _context

@{
    // Cache'de veri var mı diye kontrol ediyoruz
    if (!_cache.TryGetValue("SiteSettingsCache", out SiteSetting siteSettings))
    {
        // Yoksa veritabanından çek ve Cache'e at (boş gelme ihtimaline karşı yeni bir instance oluşturduk)
        siteSettings = _context.SiteSettings.FirstOrDefault() ?? new SiteSetting();
        _cache.Set("SiteSettingsCache", siteSettings, TimeSpan.FromDays(1));
    }
}

@model DengeWeb.Models.ContactViewModel
@{ ViewData["Title"] = @Localizer["ContactTitle"]; }

<div class="row mb-5" data-aos="fade-right" data-aos-duration="800">
    <div class="col-12">
        <h1 class="fw-bold display-5" style="color: #001f54; letter-spacing: 1px;">@Localizer["ContactTitle"]</h1>
        <div style="height: 4px; width: 60px; background-color: #001f54; margin-top: 15px;"></div>
    </div>
</div>
<hr />

<style>
    /* Denge Defence - Minimalist Form CSS */
    .defense-form-group {
        margin-bottom: 2.5rem;
    }
    
    /* Görseldeki gibi küçük, büyük harfli ve aralıklı başlıklar */
    .defense-label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #001f54; /* Kurumsal Lacivert */
        text-transform: uppercase;
        margin-bottom: 0.5rem;
        display: block;
    }
    
    /* Kutusuz, Sadece Alt Çizgili Input Alanları */
    .defense-input {
        width: 100%;
        border: none;
        border-bottom: 1px solid #ced4da; /* İnce gri alt çizgi */
        background-color: transparent;
        padding: 0.5rem 0;
        font-size: 1rem;
        color: #333;
        transition: border-color 0.3s ease;
        border-radius: 0; 
    }
    
    /* Input'a tıklandığında (Focus) */
    .defense-input:focus {
        outline: none;
        border-bottom: 2px solid #001f54; /* Çizgi lacivert ve kalın olur */
        box-shadow: none; /* Bootstrap'in varsayılan mavi parlamasını engeller */
    }
    
    .defense-input::placeholder {
        color: #adb5bd;
        font-weight: 300;
    }
    
    /* Görseldeki "Submit ->" benzeri minimalist buton */
    .defense-submit-btn {
        background: transparent;
        border: none;
        color: #001f54;
        font-size: 1.15rem;
        font-weight: 600;
        padding: 0;
        display: inline-flex;
        align-items: center;
        transition: color 0.3s ease;
        letter-spacing: 0.5px;
    }
    
    .defense-submit-btn:hover {
        color: #a3a7ab; /* Metalik gri */
    }
    
    .defense-submit-btn i {
        margin-left: 12px;
        transition: transform 0.3s ease;
    }
    
    /* Butonun üstüne gelince ok işareti sağa kayar */
    .defense-submit-btn:hover i {
        transform: translateX(8px);
    }

    /* Gönder Butonu (İnce Oval Tasarım) */
.submit-btn {
    background: transparent;
    border: 1px solid #001f44; /* Çok ince lacivert çerçeve */
    border-radius: 50px; /* Kenarları tam oval yapar (pill shape) */
    padding: 10px 28px; /* Butonun iç boşlukları (ovalliği belirginleştirir) */
    color: #001f44;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 12px; /* Yazı ile ok aralığı */
    transition: all 0.3s ease; /* Hover efekti için yumuşak geçiş */
    margin-top: 10px;
}

/* Butonun üzerine gelince (Hover) - İsteğe bağlı şık bir efekt */
.submit-btn:hover {
    background: #001f44;
    color: #ffffff;
}
</style>

@if (TempData["MailStatus"] != null)
{
    if (TempData["MailStatus"].ToString() == "success")
    {
        <div class="alert alert-success text-center mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @Localizer["ContactSuccessMessage"]
        </div>
    }
    else if (TempData["MailStatus"].ToString() == "error")
    {
        <div class="alert alert-danger text-center mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @Localizer["ContactErrorMessage"]
        </div>
    }
}


    
<section class="py-5 mt-5 bg-white">
    <div class="container pt-4">

        <!-- Ana Satır (Kolonların yeri değiştirildi) -->
        <div class="row">
            
            <!-- YENİ SOL KOLON: Ofisimiz / İletişim Bilgileri -->
            <!-- Mobilde formdan önce görünmesi için mb-5 eklendi -->
            <div class="col-lg-5 pe-lg-5 mb-5 mb-lg-0" data-aos="fade-right" data-aos-duration="1000">
    <!-- Tasarımla uyumlu, köşeli ve sağ tarafı lacivert çizgili kutu -->
    <div class="p-5 bg-light rounded-0 h-100" style="border-right: 4px solid #001f54;">
        
        <h4 class="fw-bold mb-4" style="color: #001f54;">@Localizer["ContactUs"]</h4>

        <!-- Adres -->
        <div class="d-flex align-items-start text-muted mb-4" style="line-height: 1.8;">
            <i class="fas fa-map-marker-alt me-3 mt-1" style="color: #001f54;"></i>
            <span>
                @Model.SiteSettings.Address
            </span>
        </div>

        <!-- Telefon -->
        <div class="d-flex align-items-center mb-4" style="line-height: 1.8;">
            <i class="fas fa-phone-alt me-3" style="color: #001f54;"></i>
            <a href="tel:+902165734040"
               class="text-muted text-decoration-none"
               style="transition: color 0.3s;"
               onmouseover="this.style.color='#001f54'"
               onmouseout="this.style.color='#6c757d'">
                @Model.SiteSettings.Phone
            </a>
        </div>

        <!-- E-posta -->
        <a href="mailto:info@dengedefence.com.tr"
           class="d-block text-muted text-decoration-none mb-3"
           style="transition: color 0.3s;"
           onmouseover="this.style.color='#001f54'"
           onmouseout="this.style.color='#6c757d'">
            <i class="fas fa-envelope me-2" style="color: #001f54;"></i>
            @Model.SiteSettings.Email
        </a>

    </div>
</div>

            <!-- YENİ SAĞ KOLON: İletişim Formu -->
            <div class="col-lg-7" data-aos="fade-left" data-aos-duration="1000" data-aos-delay="200">
                
                <!-- YENİ BAŞLIK: Formun üstüne alındı, boyutu küçüldü (h3) ve alt çizgisi kaldırıldı -->
                <h3 class="fw-bold mb-5" style="color: #001f54; letter-spacing: 0.5px;">@Localizer["ContactForm"]</h3>

                <form asp-controller="Home" asp-action="Contact" method="post">
                    <!-- 1. SATIR: Ad Soyad ve E-Posta -->
                    <div class="row">
                        <!-- AD SOYAD -->
                        <div class="col-md-6 defense-form-group">
                            <label class="defense-label">@Localizer["ContactNameSurname"]</label>
                            <input type="text" class="defense-input" placeholder="@Localizer["ContactNameSurnamePH"]" name="FullName" required>
                        </div>
                        <!-- E-POSTA -->
                        <div class="col-md-6 defense-form-group">
                            <label class="defense-label">@Localizer["ContactEmail"]</label>
                            <input type="email" class="defense-input" placeholder="@Localizer["ContactEmailPH"]" name="Email" required>
                        </div>
                    </div>

                    <!-- 2. SATIR: Telefon ve Konu -->
                    <div class="row">
                        <!-- TELEFON -->
                    <div class="col-md-6 defense-form-group">
                        <label class="defense-label">@Localizer["ContactPhone"]</label>
    
                        <!-- asp-for ile modeli bağladık ve pattern özelliği ile sadece rakam/+ boşluk girilmesini zorunlu kıldık -->
                        <input asp-for="Phone" type="tel" class="defense-input" placeholder="@Localizer["ContactPhonePH"]" required pattern="^[0-9\s\+\-\(\)]+$" title="@Localizer["ContactPhoneFormatMsg"]">
    
                        <!-- Olası bir hatada kırmızı uyarı metnini gösterecek alan -->
                        <span asp-validation-for="Phone" class="text-danger mt-1 d-block" style="font-size: 0.8rem;"></span>
                    </div>
                        <!-- KONU -->
                        <div class="col-md-6 defense-form-group">
                            <label class="defense-label">@Localizer["ContactSubject"]</label>
                            <input type="text" class="defense-input" placeholder="@Localizer["ContactSubjectPH"]" name="Subject" required>
                        </div>
                    </div>

                    <!-- 3. SATIR: Mesaj (Tam Genişlik) -->
                    <div class="row">
                        <div class="col-12 defense-form-group">
                            <label class="defense-label">@Localizer["ContactMessage"]</label>
                            <textarea class="defense-input" rows="7" placeholder="@Localizer["ContactMessagePH"]" style="resize: none;" name="Message" required></textarea>
                        </div>
                    </div>

                    <!--<p class="text-muted" style="font-size: 0.85rem;">abc</p>-->

                    <!-- GÖNDER BUTONU -->
                    <div class="mt-2 text-start">
                        <button type="submit" class="submit-btn">@Localizer["ContactSendButton"] <i class="fa-solid fa-arrow-right"></i></button>
                    </div>

                </form>

            </div>

        </div>
    </div>
</section>

<!-- Google Haritalar Kartı -->
@if (!string.IsNullOrWhiteSpace(Model.SiteSettings?.GoogleMapEmbedUrl))
{
    <div class="card shadow-sm" data-aos="fade-up" data-aos-duration="1000">
        <div class="card-body p-0">
            <iframe
                src="@Model.SiteSettings.GoogleMapEmbedUrl"
                title="Google Maps"
                width="100%"
                height="400"
                style="border:0; border-radius: 0.375rem;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade">
            </iframe>
        </div>
    </div>
}
</div>