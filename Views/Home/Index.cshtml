@model List<DengeWeb.Models.ProductViewModel>
@{ ViewData["Title"] = "Anasayfa"; }

<!-- 1. Karşılama ve Vizyon Alanı -->
<!-- data-aos="fade-up" sayesinde ekran buraya gelince aşağıdan yukarı doğru belirecek -->
<section class="py-5 mt-5" data-aos="fade-up" data-aos-duration="1000">
    <div class="container text-center">
        <!-- Daha önce yazdığımız metalik yazıyı başlığa uyguladık -->
        <h1 class="display-4 fw-bold text-dark mb-4" style="font-size: 3rem;">Geleceğin Savunma Teknolojileri</h1>
        <p class="lead text-muted w-75 mx-auto">
            Güvenliğinizi en üst düzeye çıkarmak için yenilikçi, sürdürülebilir ve yüksek teknolojili savunma çözümleri üretiyoruz. Gücümüzü Ar-Ge'den, ilhamımızı geleceğin ihtiyaçlarından alıyoruz.
        </p>
    </div>
</section>

<!-- 2. Stok Video Alanı (Otomatik Oynayan) -->
<section class="py-5" data-aos="zoom-in" data-aos-duration="1200" data-aos-delay="200">
    <div class="container">
        <!-- Video kapsayıcısı: köşeleri yuvarlatılmış ve gölgeli -->
        <div class="video-container rounded shadow-lg overflow-hidden" style="max-height: 550px; background: #000;">
            <!-- autoplay, loop, muted özellikleri videonun sessiz ve otomatik döngüde dönmesini sağlar -->
            <video autoplay loop muted playsinline class="w-100" style="object-fit: cover; opacity: 0.85;">
                <!-- Kendi videnonu wwwroot/videos/ klasörüne atıp src kısmını değiştirebilirsin -->
                <source src="https://www.w3schools.com/html/mov_bbb.mp4" type="video/mp4">
                Tarayıcınız bu videoyu desteklemiyor.
            </video>
        </div>
    </div>
</section>

<!-- Ürün Slider Başlangıcı -->
        <div id="productCarousel" class="carousel slide carousel-fade shadow-sm rounded navy-frame fixed-slider" data-bs-ride="carousel">
            
            <!-- 1. DİNAMİK NOKTALAR (Indicators) -->
            <div class="carousel-indicators mb-0 pb-2">
                @for (int i = 0; i < Model.Count; i++)
                {
                    <button type="button" 
                            data-bs-target="#productCarousel" 
                            data-bs-slide-to="@i" 
                            class="@(i == 0 ? "active bg-dark" : "bg-dark")" 
                            aria-current="@(i == 0 ? "true" : "false")">
                    </button>
                }
            </div>

            <!-- 2. DİNAMİK ÜRÜNLER (Carousel Items) -->
            <div class="carousel-inner bg-light rounded fixed-slider">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var urun = Model[i];
                    
                    <!-- i == 0 ise ilk elemana 'active' sınıfı eklenir -->
                    <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                        <div class="row align-items-center h-100 p-4 p-md-5">
                            <div class="col-md-6 text-center mb-4 mb-md-0">
                                <img src="@urun.ImageUrl" class="img-fluid rounded shadow" style="max-height: 380px; object-fit: contain;" alt="@urun.Name">
                            </div>
                            <div class="col-md-6 px-md-5">
                                <h3 class="fw-bold mb-3" style="color: #001f54;">@urun.Name</h3>
                                <p class="text-muted mb-4">@urun.Description</p>
                                
                                <!-- Eğer ürünün kendi özel detay sayfasına gidecekse asp-route-id="@urun.Id" eklenebilir -->
                                <a asp-controller="Home" asp-action="Products" class="btn btn-outline-dark px-4 py-2 fw-bold" style="border-radius: 0; letter-spacing: 1px;">
                                    DAHA FAZLA <i class="fas fa-chevron-right ms-2" style="font-size: 0.8rem;"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Sağ/Sol Oklar (Sabit kalıyor) -->
            <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev" style="width: 5%;">
                <span class="carousel-control-prev-icon" aria-hidden="true" style="filter: invert(100%);"></span>
                <span class="visually-hidden">Önceki</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next" style="width: 5%;">
                <span class="carousel-control-next-icon" aria-hidden="true" style="filter: invert(100%);"></span>
                <span class="visually-hidden">Sonraki</span>
            </button>
        </div>

<!-- 4. İletişim / Call to Action Alanı -->
<!-- Taslaktaki "beyaz, çok hafif gri arkaplan" notuna uygun #f8f9fa arka planı verildi -->
<section class="py-5 mb-5" style="background-color: #f8f9fa;" data-aos="fade-up" data-aos-duration="1000">
    <div class="container text-center py-5">
        <h2 class="fw-bold mb-2" style="color: #001f54; letter-spacing: 2px;">İLETİŞİM</h2>
        <h4 class="text-muted mb-4 fw-light">Bilgi almak ister misiniz?</h4>
        <p class="mb-5 w-50 mx-auto text-secondary">
            Ürünlerimiz hakkında detaylı bilgi almak, projelerinize özel çözümler üretmek ve uzman mühendis kadromuzla görüşmek için hemen iletişime geçin.
        </p>
        <!-- Ovalleştirilmiş, belirgin "İletişim" butonu -->
        <a asp-controller="Home" asp-action="Contact" class="btn btn-dark btn-lg px-5 py-3 shadow-sm" style="border-radius: 50px; font-weight: 600; letter-spacing: 1px;">
            İLETİŞİM SAYFASI
        </a>
    </div>
</section>