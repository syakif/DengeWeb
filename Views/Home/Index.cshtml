@model List<DengeWeb.Models.ProductViewModel>
@{ ViewData["Title"] = "Anasayfa"; }

@{ 
    ViewData["Title"] = "Anasayfa"; 
    // Layout'a bu sayfanın anasayfa olduğunu ve menüyü şeffaf yapması gerektiğini bildiriyoruz!
    ViewData["IsHome"] = true; 
}

<!-- 1. SİNEMATİK TAM EKRAN VİDEO VE YAZI ALANI -->
<!-- vh-100 ekranın %100 yüksekliğini kaplar -->
<section class="position-relative d-flex align-items-center justify-content-center w-100 vh-100 overflow-hidden">
    
    <!-- Arka Plan Videosu -->
    <video autoplay loop muted playsinline class="position-absolute w-100 h-100 top-0 start-0" style="object-fit: cover; z-index: -2;">
        <source src="/images/FPV Drone Flight through Beautiful Iceland Canyon_1080p.mp4" type="video/mp4">
    </video>

    <!-- Videonun Üzerindeki Siyah Karartma (Opacity: 0.6 = %60 karanlık) -->
    <div class="position-absolute w-100 h-100 top-0 start-0 bg-dark" style="opacity: 0.5; z-index: -1;"></div>

    <!-- Ortalanmış Beyaz, Gölgeli Yazılar -->
    <div class="container text-center text-white position-relative" style="z-index: 1;" data-aos="fade-up" data-aos-duration="1200">
        <!-- text-shadow ile yazıya referanstaki gibi siyah gölge ekledik -->
        <h1 class="display-3 fw-bold mb-4" style="text-shadow: 2px 4px 10px rgba(0,0,0,0.8); letter-spacing: 2px;">
            Geleceğin Savunma Teknolojileri
        </h1>
        <p class="lead w-75 mx-auto mb-5" style="text-shadow: 1px 2px 6px rgba(0,0,0,0.9); font-size: 1.3rem;">
            Güvenliğinizi en üst düzeye çıkarmak için yenilikçi, sürdürülebilir ve yüksek teknolojili savunma çözümleri üretiyoruz.
        </p>
        
        <!-- İsteğe bağlı: Referans görseldeki gibi yan yana kutucuklu butonlar eklenebilir -->
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Products" class="btn btn-outline-light px-4 py-2" style="border-radius: 0; backdrop-filter: blur(5px);">
                Ürünlerimiz
            </a>
        </div>
    </div>
</section>

<!-- 2. Stok Video Alanı (Otomatik Oynayan) -->


<!-- Ürün Slider Başlangıcı -->
        <!-- 2. ÜRÜNLER ALANI (Çerçevesiz, Tam Ekran, Lacivert/Beyaz Konsept) -->
<!-- m-0 ile dış boşlukları sıfırladık ki videoya tam yapışsın -->
<section class="m-0 py-5 position-relative" style="background: linear-gradient(135deg, #001f54 0%, #000428 65%, #150144 100%);">
    
    <!-- İsteğe Bağlı: Video ile slider arasına çok ince, şık bir beyaz ayırıcı çizgi -->
    <!-- <div class="position-absolute top-0 start-0 w-100" style="height: 2px; background: rgba(255,255,255,0.2);"></div> -->

    <!-- container-fluid ile slider'ın sağdan soldan daha geniş ve ferah durmasını sağladık -->
    <div class="container-fluid px-md-5">
        
        <!-- Frame, border, shadow ve bg sınıfları tamamen kaldırıldı -->
        <div id="productCarousel" class="carousel slide carousel-fade fixed-slider" data-bs-ride="carousel">
            
            <!-- Noktalar (Beyaz Yapıldı) -->
            <div class="carousel-indicators mb-0 pb-2">
                @for (int i = 0; i < Model.Count; i++)
                {
                    <button type="button" 
                            data-bs-target="#productCarousel" 
                            data-bs-slide-to="@i" 
                            class="@(i == 0 ? "active bg-white" : "bg-white")" 
                            aria-current="@(i == 0 ? "true" : "false")">
                    </button>
                }
            </div>

            <!-- Ürünler -->
            <div class="carousel-inner h-100" data-aos="fade-up" data-aos-duration="1000">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var urun = Model[i];
                    <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                        <div class="row align-items-center h-100 p-4 p-md-5">
                            
                            <!-- Sol: Resim (Kutu yok, 3D gölge efekti var) -->
                            <div class="col-md-6 text-center mb-4 mb-md-0">
                                <!-- filter: drop-shadow komutu, resmi bir kutuya hapsetmek yerine objenin kendi şekline göre gölge atar -->
                                <img src="@urun.ImageUrl" class="img-fluid" style="max-height: 420px; object-fit: contain; filter: drop-shadow(0px 15px 25px rgba(0,0,0,0.6));" alt="@urun.Name">
                            </div>
                            
                            <!-- Sağ: Yazı (Bembeyaz ve Daha Büyük) -->
                            <div class="col-md-6 px-md-5">
                                <h2 class="fw-bold mb-3 text-white display-5" style="letter-spacing: 1px;">@urun.Name</h2>
                                <p class="mb-5" style="color: #e0e5ec; font-size: 1.2rem; font-weight: 300;">@urun.Description</p>
                                
                                <!-- Buton (İnce, beyaz kenarlıklı, zarif) -->
                                <a asp-controller="Home" asp-action="Products" class="btn btn-outline-light px-5 py-3 fw-bold" style="border-radius: 0; letter-spacing: 2px;">
                                    DAHA FAZLA <i class="fas fa-chevron-right ms-2" style="font-size: 0.9rem;"></i>
                                </a>
                            </div>
                            
                        </div>
                    </div>
                }
            </div>

            <!-- Sağ/Sol Oklar (Siyah yapan filter komutu silindi, artık varsayılan olarak beyazlar) -->
            <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev" style="width: 8%;">
                <span class="carousel-control-prev-icon" aria-hidden="true" style="width: 3rem; height: 3rem;"></span>
                <span class="visually-hidden">Önceki</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next" style="width: 8%;">
                <span class="carousel-control-next-icon" aria-hidden="true" style="width: 3rem; height: 3rem;"></span>
                <span class="visually-hidden">Sonraki</span>
            </button>
            
        </div>
    </div>
</section>

<!-- 3. HAKKIMIZDA ÖZET (CTA) ALANI -->
<!-- py-5 (padding) değerini py-6 (veya style ile çok daha büyük bir değer) ile artırarak alanı genişletiyoruz -->
<section style="background-color: #001f54; border-top: 2px solid rgba(255,255,255,0.1); padding-top: 7rem; padding-bottom: 7rem;">
    <div class="container">
        <div class="row align-items-center">
            
            <!-- SOL KOLON: Sadece Beyaz Logo (Boyutu da biraz büyütüldü) -->
            <div class="col-md-5 text-center text-md-start mb-5 mb-md-0" data-aos="fade-right" data-aos-duration="1000" data-aos-delay="100">
                <img src="~/images/ddlogonobg.png" alt="Denge Defence Logo" class="img-fluid" style="max-height: 240px; object-fit: contain; filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.3));">
            </div>

            <!-- SAĞ KOLON: Başlık, Yazı ve Solid Beyaz Buton -->
            <!-- col-md-7 ile sağ kolona biraz daha fazla yer verdik -->
            <div class="col-md-7 ps-md-5" data-aos="fade-left" data-aos-duration="1000" data-aos-delay="200">
                
                <!-- Sadece HAKKIMIZDA yazan beyaz başlık -->
                <h2 class="fw-bold mb-4 text-white" style="letter-spacing: 2px; font-size: 2.5rem; text-transform: uppercase;">
                    HAKKIMIZDA
                </h2>
                
                <!-- Açıklama Metni (Font boyutu hafif büyütüldü) -->
                <p class="mb-5" style="color: #e0e5ec; font-size: 1.25rem; font-weight: 300; line-height: 1.8;">
                    Güvenliğinizi en üst düzeye çıkarmak için yenilikçi ve yüksek teknolojili savunma çözümleri geliştiriyoruz. Uzman mühendis kadromuz ve yerli üretim gücümüzle sektörde öncü olmaktan gurur duyuyoruz.
                </p>
                
                <!-- YENİ BUTON: Arka plan tam beyaz, yazı lacivert, içi dolgulu (solid) -->
                <style>
                    .btn-solid-white {
                        background-color: #ffffff;
                        color: #001f54;
                        border: 2px solid #ffffff;
                        transition: all 0.3s ease;
                    }
                    .btn-solid-white:hover {
                        background-color: #e0e5ec; /* Hover'da çok hafif gümüş/gri olur */
                        color: #001f54;
                        border-color: #e0e5ec;
                        transform: translateY(-3px); /* Hover'da çok hafif havaya kalkar */
                        box-shadow: 0 10px 20px rgba(0,0,0,0.2);
                    }
                </style>

                <a asp-controller="Home" asp-action="About" class="btn btn-solid-white px-5 py-3 fw-bold" style="border-radius: 0; letter-spacing: 1px;">
                    HAKKIMIZDA DAHA FAZLA <i class="fas fa-arrow-right ms-2"></i>
                </a>
                
            </div>
            
        </div>
    </div>
</section>

<!-- 4. İletişim / Call to Action Alanı -->
<!-- Taslaktaki "beyaz, çok hafif gri arkaplan" notuna uygun #f8f9fa arka planı verildi -->
<section class="py-5 mb-5" style="background-color: #f8f9fa;" data-aos="fade-up" data-aos-duration="1000">
    <div class="container text-center py-5">
        <h2 class="fw-bold mb-2" style="color: #001f54; letter-spacing: 2px;">İLETİŞİM</h2>
        <h4 class="text-muted mb-4 fw-light">Bilgi almak ister misiniz?</h4>
        <p class="mb-5 w-50 mx-auto text-secondary">
            Ürünlerimiz hakkında detaylı bilgi almak, projelerinize özel çözümler üretmek ve uzman mühendis kadromuzla görüşmek için hemen iletişime geçin.
        </p>
        <!-- Ovalleştirilmiş, belirgin "İletişim" butonu -->
        <a asp-controller="Home" asp-action="Contact" class="btn btn-dark btn-lg px-5 py-3 shadow-sm" style="border-radius: 50px; font-weight: 600; letter-spacing: 1px;">
            İLETİŞİM SAYFASI
        </a>
    </div>
</section>