@model IEnumerable<DengeWeb.Models.ContactMessage>

<h2 class="mb-4">Gelen Mesajlar</h2>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Durum</th>
                    <th>Gönderen</th>
                    <th>Konu</th>
                    <th>Tarih</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var msg in Model)
                {
                    <tr class="@(msg.IsRead ? "" : "table-warning fw-bold")">
                        <td>
                            @if(msg.IsRead){ <span class="badge bg-secondary">Okundu</span> }
                            else { <span class="badge bg-success">Yeni</span> }
                        </td>
                        <td>@msg.AdSoyad</td>
                        <td>@msg.Konu</td>
                        <td>@msg.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@msg.Id" class="btn btn-sm btn-primary">Oku</a>
                            <a asp-action="Delete" asp-route-id="@msg.Id" class="btn btn-sm btn-danger" onclick="return confirm('Bu mesajı silmek istediğinize emin misiniz?');">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>