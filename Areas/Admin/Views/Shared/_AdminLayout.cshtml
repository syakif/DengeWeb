<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Denge Defence - Yönetim Paneli</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { background-color: #f8f9fa; }
        .sidebar { min-height: 100vh; background-color: #212529; color: white; padding-top: 20px;}
        .sidebar a { color: #adb5bd; text-decoration: none; padding: 10px 20px; display: block;}
        .sidebar a:hover, .sidebar a.active { color: white; background-color: #343a40;}
        .content-area { padding: 30px; }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sol Kenar Çubuğu -->
        <div class="sidebar" style="width: 250px;">
            <h4 class="text-center mb-4 border-bottom pb-3">Denge Defense Admin</h4>
            <a href="/Admin/Message/Index"><i class="fas fa-envelope me-2"></i> Gelen Mesajlar</a>
            <a href="/Admin/Product/Index"><i class="fas fa-box me-2"></i> Ürün Yönetimi</a>
            <a href="/Admin/SiteSetting/Index"><i class="fas fa-cogs me-2"></i> Site Ayarları</a>
            <a href="/" target="_blank"><i class="fas fa-globe me-2"></i> Siteyi Görüntüle</a>
            <a href="/Admin/Auth/Logout" class="text-danger mt-5"><i class="fas fa-sign-out-alt me-2"></i> Çıkış Yap</a>
        </div>

        <!-- Sağ İçerik Alanı -->
        <div class="flex-grow-1 content-area">
            @RenderBody()
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>