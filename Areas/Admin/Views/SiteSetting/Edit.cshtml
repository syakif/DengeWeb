@model DengeWeb.Models.SiteSetting

<h2>Dil Ayarını Düzenle</h2>

<form asp-action="Edit" method="post" class="mt-4" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    
    <!-- DİKKAT: Eski resimlerin URL'leri silinmesin diye burada gizli tutuyoruz -->
    <input type="hidden" asp-for="FaviconUrl" />
    <input type="hidden" asp-for="HeaderLogoUrl" />
    <input type="hidden" asp-for="HeaderWhiteLogoUrl" />
    <input type="hidden" asp-for="FooterLogoUrl" />
    <input type="hidden" asp-for="IndexStockVideoUrl" />
    <input type="hidden" asp-for="IndexAboutImageUrl" />
    <input type="hidden" asp-for="AboutMissionVisionImageUrl" />
    <input type="hidden" asp-for="AboutValuesImageUrl" />

    <!-- SEKME BAŞLIKLARI -->
    <ul class="nav nav-tabs" id="settingTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#genel" type="button">Genel & İletişim</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#gorsel" type="button">Logolar & Medya</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#anasayfa" type="button">Ana Sayfa</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#hakkimizda" type="button">Hakkımızda</button>
        </li>
    </ul>

    <!-- SEKME İÇERİKLERİ -->
    <div class="tab-content card border-top-0 p-4 shadow-sm" id="settingTabsContent">
        
        <!-- 1. GENEL & İLETİŞİM TAB'I -->
        <div class="tab-pane fade show active" id="genel">
            <div class="row">
                <div class="col-md-2 mb-3">
                    <label>Dil Kodu</label>
                    <input asp-for="Language" class="form-control" />
                </div>
                <div class="col-md-5 mb-3">
                    <label>E-Posta</label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="col-md-5 mb-3">
                    <label>Telefon</label>
                    <input asp-for="Phone" class="form-control" />
                </div>
                <div class="col-12 mb-3">
                    <label>Açık Adres</label>
                    <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-12 mb-3">
                    <label>İletişim Sayfası Google Harita URL (Embed)</label>
                    <input asp-for="GoogleMapEmbedUrl" class="form-control" />
                </div>
                <h5 class="mt-4 border-bottom pb-2">Sosyal Medya Linkleri</h5>
                <div class="col-md-6 mb-3"><label>LinkedIn</label><input asp-for="FooterLinkedinUrl" class="form-control" /></div>
                <div class="col-md-6 mb-3"><label>Twitter (X)</label><input asp-for="FooterTwitterUrl" class="form-control" /></div>
                <div class="col-md-6 mb-3"><label>Instagram</label><input asp-for="FooterInstagramUrl" class="form-control" /></div>
                <div class="col-md-6 mb-3"><label>YouTube</label><input asp-for="FooterYoutubeUrl" class="form-control" /></div>
                <div class="col-md-6 mb-3"><label>Facebook</label><input asp-for="FooterFacebookUrl" class="form-control" /></div>
            </div>
        </div>

        <!-- 2. LOGOLAR & MEDYA TAB'I -->
        <div class="tab-pane fade" id="gorsel">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Header Logosu</label>
                    <input type="file" name="headerLogoUpload" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.HeaderLogoUrl)) { <img src="@Model.HeaderLogoUrl" height="40" class="mt-2 border rounded p-1 bg-light" /> }
                </div>
                <div class="col-md-6 mb-3">
                    <label>Header Beyaz Logo</label>
                    <input type="file" name="headerWhiteLogoUpload" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.HeaderWhiteLogoUrl)) { <img src="@Model.HeaderWhiteLogoUrl" height="40" class="mt-2 border rounded p-1 bg-dark" /> }
                </div>
                <div class="col-md-6 mb-3">
                    <label>Footer Logosu</label>
                    <input type="file" name="footerLogoUpload" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.FooterLogoUrl)) { <img src="@Model.FooterLogoUrl" height="40" class="mt-2 border rounded p-1 bg-light" /> }
                </div>
                <div class="col-md-6 mb-3">
                    <label>Favicon</label>
                    <input type="file" name="faviconUpload" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.FaviconUrl)) { <img src="@Model.FaviconUrl" height="32" class="mt-2 border rounded p-1" /> }
                </div>
                <div class="col-12 mb-3">
                    <label>Footer Telif Hakkı Yazısı (Copyright)</label>
                    <input asp-for="FooterCopyrightText" class="form-control" />
                </div>
            </div>
        </div>

        <!-- 3. ANA SAYFA TAB'I -->
        <div class="tab-pane fade" id="anasayfa">
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label>Ana Sayfa Video (Arkaplan)</label>
                    <input type="file" name="indexStockVideoUpload" class="form-control" accept="video/*" />
                    @if (!string.IsNullOrEmpty(Model.IndexStockVideoUrl)) { <span class="text-success small d-block mt-1"><i class="fas fa-check-circle"></i> Mevcut video yüklü</span> }
                </div>
                <div class="col-md-6 mb-3"><label>Giriş Başlığı</label><input asp-for="IndexEntryTitle" class="form-control" /></div>
                <div class="col-md-6 mb-3"><label>Giriş Alt Metni</label><input asp-for="IndexEntryDescription" class="form-control" /></div>
                
                <h5 class="mt-4 border-bottom pb-2">Ana Sayfa - Hakkımızda Kısmı</h5>
                <div class="col-md-6 mb-3"><label>Başlık</label><input asp-for="IndexAboutTitle" class="form-control" /></div>
                <div class="col-md-6 mb-3"><label>Buton Yazısı</label><input asp-for="IndexAboutButtonText" class="form-control" /></div>
                <div class="col-12 mb-3"><label>Özet Açıklama</label><textarea asp-for="IndexAboutDescription" class="form-control" rows="3"></textarea></div>
                <div class="col-12 mb-3">
                    <label>Hakkımızda Görseli</label>
                    <input type="file" name="indexAboutImageUpload" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.IndexAboutImageUrl)) { <img src="@Model.IndexAboutImageUrl" height="60" class="mt-2 border rounded" /> }
                </div>

                <h5 class="mt-4 border-bottom pb-2">Ana Sayfa - İletişim Kısmı (CTA)</h5>
                <div class="col-md-4 mb-3"><label>Başlık</label><input asp-for="IndexContactTitle" class="form-control" /></div>
                <div class="col-md-4 mb-3"><label>Alt Başlık</label><input asp-for="IndexContactSubtitle" class="form-control" /></div>
                <div class="col-md-4 mb-3"><label>Buton Yazısı</label><input asp-for="IndexContactButtonText" class="form-control" /></div>
                <div class="col-12"><label>Açıklama</label><textarea asp-for="IndexContactDescription" class="form-control" rows="2"></textarea></div>
            </div>
        </div>

        <!-- 4. HAKKIMIZDA SAYFASI TAB'I -->
        <div class="tab-pane fade" id="hakkimizda">
            <div class="row">
                <div class="col-12 mb-3"><label>Sayfa Ana Başlığı</label><input asp-for="AboutTitle" class="form-control" /></div>
                <div class="col-12 mb-3"><label>Ana Açıklama Metni</label><textarea asp-for="AboutDescription" class="form-control" rows="4"></textarea></div>
                
                <div class="col-md-6 mb-3"><label>Misyon & Vizyon Başlık</label><input asp-for="AboutMissionVisionTitle" class="form-control" /></div>
                <div class="col-md-6 mb-3">
                    <label>Misyon Görseli</label>
                    <input type="file" name="aboutMissionVisionImageUpload" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.AboutMissionVisionImageUrl)) { <img src="@Model.AboutMissionVisionImageUrl" height="60" class="mt-2 border rounded" /> }
                </div>
                <div class="col-12 mb-3"><label>Misyon & Vizyon Açıklama</label><textarea asp-for="AboutMissionVisionDescription" class="form-control" rows="3"></textarea></div>
                
                <div class="col-md-6 mb-3"><label>Etik Değerler Başlık</label><input asp-for="AboutEthicalValuesTitle" class="form-control" /></div>
                <div class="col-md-6 mb-3"><label>Değerlerimiz Başlık</label><input asp-for="AboutValuesTitle" class="form-control" /></div>
                <div class="col-12 mb-3"><label>Etik Değerler Metni</label><textarea asp-for="AboutEthicalValuesDescription" class="form-control" rows="3"></textarea></div>
                <div class="col-12 mb-3"><label>Değerlerimiz Metni</label><textarea asp-for="AboutValuesDescription" class="form-control" rows="3"></textarea></div>
                <div class="col-12 mb-3">
                    <label>Değerlerimiz Görseli</label>
                    <input type="file" name="aboutValuesImageUpload" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.AboutValuesImageUrl)) { <img src="@Model.AboutValuesImageUrl" height="60" class="mt-2 border rounded" /> }
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-warning mt-4 px-5 py-2 fw-bold shadow">Güncelle</button>
    <a asp-action="Index" class="btn btn-secondary mt-4 ms-2 py-2">İptal</a>
</form>