@model IEnumerable<DengeWeb.Models.SiteSetting>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Site Ayarları (Diller)</h2>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus"></i> Yeni Dil Ekle</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Dil Kodu</th>
                    <th>İletişim E-Posta</th>
                    <th>Telefon</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-uppercase">@item.Language</td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Ayarları Düzenle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>