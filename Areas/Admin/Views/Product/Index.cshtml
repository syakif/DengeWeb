@model IEnumerable<DengeWeb.Models.Product>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Ürün Yönetimi</h2>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus"></i> Yeni Ürün Ekle</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Görsel</th>
                    <th>Ürün Adı</th>
                    <th>Durum</th>
                    <th>Eklenme Tarihi</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><img src="@item.ImageUrl" width="50" height="50" style="object-fit:cover;" class="rounded" /></td>
                        <td class="align-middle fw-bold">@item.Name</td>
                        <td class="align-middle">
                            @if(item.IsActive) { <span class="badge bg-success">Aktif</span> }
                            else { <span class="badge bg-danger">Pasif</span> }
                        </td>
                        <td class="align-middle">@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                        <td class="text-end align-middle">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?');">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>