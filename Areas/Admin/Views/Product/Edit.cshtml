@model DengeWeb.Models.Product

<h2>@(Model?.Id == 0 || Model == null ? "Yeni Ürün Ekle" : "Ürünü Düzenle")</h2>

<div class="card shadow-sm border-0 mt-4">
    <div class="card-body">
        <form asp-action="@(Model?.Id == 0 || Model == null ? "Create" : "Edit")" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedDate" />
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Ürün Dili</label>
                    <select asp-for="Language" class="form-select">
                        <option value="tr">Türkçe (tr)</option>
                        <option value="en">İngilizce (en)</option>
        
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label>Ürün Adı</label>
                    <input asp-for="Name" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label>Durum</label>
                    <select asp-for="IsActive" class="form-select">
                        <option value="true">Aktif (Sitede Görünsün)</option>
                        <option value="false">Pasif (Gizle)</option>
                    </select>
                </div>
                <div class="col-12 mb-3">
                    <label>Kısa Açıklama</label>
                    <input asp-for="ShortDescription" class="form-control" />
                </div>
                <div class="col-12 mb-3">
                    <label>Uzun Açıklama</label>
                    <textarea asp-for="LongDescription" class="form-control" rows="5"></textarea>
                </div>
                <!-- ANA GÖRSEL (Bilgisayardan Seç / Sürükle Bırak) -->
                <div class="col-md-6 mb-3">
                    <label>Ana Görsel (Resim Seçin veya Sürükleyin)</label>
                    <input type="file" name="imageUpload" class="form-control" accept="image/*" />
                    <!-- Eğer Edit sayfasındaysak ve mevcut bir resim varsa URL'sini gizli tutalım ki kaybolmasın -->
                    <input type="hidden" asp-for="ImageUrl" />
                </div>
                <!-- BROŞÜR (Bilgisayardan Seç / Sürükle Bırak) -->
                <div class="col-md-6 mb-3">
                    <label>Broşür Yükle (PDF Seçin veya Sürükleyin)</label>
                    <input type="file" name="brochureUpload" class="form-control" accept=".pdf" />
                    <input type="hidden" asp-for="BrochureUrl" />
                </div>
                <!-- GALERİ (Çoklu Dosya Seçimi) -->
                <div class="col-12 mb-3">
                    <label>Galeri Görselleri (Birden fazla resim seçebilirsiniz)</label>
                    <!-- "multiple" özelliği sayesinde tek seferde 5 resim birden seçilebilir -->
                    <input type="file" name="galleryUploads" class="form-control" accept="image/*" multiple />
                </div>
            </div>
            <button type="submit" class="btn btn-success mt-3">Güncelle</button>
            <a asp-action="Index" class="btn btn-secondary mt-3 ms-2">İptal</a>
        </form>
    </div>
</div>