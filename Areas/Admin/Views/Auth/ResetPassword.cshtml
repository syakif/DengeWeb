@model ResetPasswordViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html><head><title>Şifreyi Yenile</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /></head>
<body class="bg-dark d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div class="card p-4 shadow" style="width: 400px;">
        <h3 class="text-center mb-4">Yeni Şifre</h3>
        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Token" type="hidden" />
            <label asp-for="Password" class="form-label">Yeni şifre</label>
            <input asp-for="Password" class="form-control mb-3" autocomplete="new-password" />
            <label asp-for="ConfirmPassword" class="form-label">Yeni şifre tekrar</label>
            <input asp-for="ConfirmPassword" class="form-control mb-3" autocomplete="new-password" />
            <button type="submit" class="btn btn-primary w-100">Şifreyi Yenile</button>
        </form>
    </div>
</body></html>