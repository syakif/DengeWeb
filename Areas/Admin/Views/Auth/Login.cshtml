@model LoginViewModel
@{
    Layout = null; // Giriş sayfasında sol menü görünmez!
}
<!DOCTYPE html>
<html>
<head>
    <title>Admin Giriş</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-dark d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div class="card p-4 shadow" style="width: 400px; border-radius: 10px;">
        <h3 class="text-center mb-4">Yönetici Girişi</h3>
        
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        }

        <form asp-area="Admin" asp-controller="Auth" asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label">E-Posta</label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label class="form-label">Şifre</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
        </form>
        <a asp-action="ForgotPassword" class="text-center mt-3">Şifremi unuttum</a>
    </div>
</body>
</html>