@model ForgotPasswordViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html><head><title>Şifremi Unuttum</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /></head>
<body class="bg-dark d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div class="card p-4 shadow" style="width: 400px;">
        <h3 class="text-center mb-4">Şifremi Unuttum</h3>
        @if (ViewBag.Message != null) { <div class="alert alert-info">@ViewBag.Message</div> }
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <label asp-for="Email" class="form-label">E-posta</label>
            <input asp-for="Email" class="form-control mb-3" autocomplete="email" />
            <button type="submit" class="btn btn-primary w-100">Bağlantı Gönder</button>
        </form>
        <a asp-action="Login" class="text-center mt-3">Giriş sayfasına dön</a>
    </div>
</body></html>